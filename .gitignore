# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# Supabase CLI linkage and cached remote metadata are machine-local.
supabase/.temp/
tools/sandbox/supabase/migrations/20261030000000_hardened_tab_hub_baseline.sql
tools/sandbox/supabase/.temp/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local fake Resend request log and control file (tools/collections-local/fake-resend.mjs)
tools/collections-local/.fake-resend/

# Database exports and real data never belong in Git
/backups/
/docs/datamodel/csv_dataset/
/docs/datamodel/*.zip
